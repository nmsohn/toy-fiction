{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Claude": { "ApiKey": "" },
  "Mubert": { "ApiKey": "" },
  "Api": {
    "RouterPrefix": "api/v{version:apiVersion}"
  },
  "Jwt": {
    "PrivateKeyBase64": "",
    "PublicKeyBase64": "",
    "Issuer": "NarrativeEngine",
    "Audience": "NarrativeEngine",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Embedding": {
    "Dimensions": 1536,
    "Model": "voyage-3"
  },
  "Copilot": {
    "MaxOutputTokens": 4096
  },
  "Resilience": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "ContextCompressor": {
    "ThresholdRatio": 0.8,
    "MinRecentTokens": 500
  },
  "Cache": {
    "EmotionTtlHours": 24,
    "BgmTtlHours": 1,
    "SummaryTtlDays": 7
  },
  "ClientRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "ClientIdHeader": "X-User-Id",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 60 },
      { "Endpoint": "*", "Period": "1d", "Limit": 3000 },
      { "Endpoint": "post:/api/*/emotion", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/*/emotion", "Period": "1d", "Limit": 100 },
      { "Endpoint": "post:/api/*/consistency", "Period": "1m", "Limit": 10 },
      { "Endpoint": "post:/api/*/consistency", "Period": "1d", "Limit": 100 },
      { "Endpoint": "post:/api/music/bgm", "Period": "1m", "Limit": 20 },
      { "Endpoint": "post:/api/music/bgm", "Period": "1d", "Limit": 100 }
    ]
  },
  "ClientRateLimitPolicies": {
    "ClientRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 30  },
      { "Endpoint": "*", "Period": "1h", "Limit": 500 },
      { "Endpoint": "post:/api/*/emotion", "Period": "1m", "Limit": 5   },
      { "Endpoint": "post:/api/*/emotion", "Period": "1d", "Limit": 50  },
      { "Endpoint": "post:/api/*/consistency", "Period": "1m", "Limit": 5   },
      { "Endpoint": "post:/api/*/consistency", "Period": "1d", "Limit": 50  },
      { "Endpoint": "post:/api/music/bgm", "Period": "1m", "Limit": 5   },
      { "Endpoint": "post:/api/music/bgm", "Period": "1d", "Limit": 50  }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/narrative-engine-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
